rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doctors collection — any authenticated user can read/write
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Counters — used for auto-incrementing doctor IDs
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Patients collection — any authenticated user can read/write
    match /patients/{patientId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // Data subcollection — any authenticated user can read/write
      match /data/{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Appointments collection — patients create, doctors read/update
    match /appointments/{appointmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
