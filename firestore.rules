rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doctors collection — each doctor reads/writes only their own doc
    match /doctors/{doctorId} {
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }

    // Counters — used for auto-incrementing doctor IDs
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Patients collection — any authenticated user can read (for app-website linking)
    // Writes restricted to owner or assigned doctor
    match /patients/{patientId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == patientId ||
        request.resource.data.doctorId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );

      // Data subcollection — any authenticated user can read, owner or doctor can write
      match /data/{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          request.auth.uid == patientId ||
          request.resource.data.doctorId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid
        );
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
