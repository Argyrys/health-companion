rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doctors collection — each doctor reads/writes only their own doc
    match /doctors/{doctorId} {
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }

    // Counters — used for auto-incrementing doctor IDs
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    // Patients collection
    match /patients/{patientId} {
      // Doctor can read/write patients assigned to them
      // Patient can read/write their own data
      allow read, write: if request.auth != null && (
        request.auth.uid == patientId ||
        request.resource.data.doctorId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );

      // Data subcollection
      match /data/{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == patientId ||
          request.resource.data.doctorId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid
        );
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
