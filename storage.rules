rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Patient files
    match /patients/{patientId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
