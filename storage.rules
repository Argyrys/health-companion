rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Patient files — organized by patient UID
    match /patients/{userId}/{allPaths=**} {
      // Anyone authenticated can read (doctors need to view reports, eye images)
      allow read: if request.auth != null;
      // Only the owner can write their own files
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reports directory — read by authenticated users, write by owner
    match /reports/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
